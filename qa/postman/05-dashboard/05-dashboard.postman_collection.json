	"item": [
		{
			"name": "Setup & Auth",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const email = \"qa_dashboard_\" + Date.now() + \"@example.com\";",
									"pm.environment.set(\"test_email\", email);",
									"pm.environment.set(\"test_password\", \"Test@1234\");"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 - Registered\", () => {",
									"    pm.response.to.have.status(201);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{test_email}}\",\n  \"fullName\": \"QA Dashboard Tester\",\n  \"password\": \"{{test_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 - Logged In\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.environment.set(\"token\", jsonData.token);",
									"pm.environment.set(\"userId\", jsonData.user.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Create Project for Tasks",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 - Project Created\", () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.environment.set(\"projectId\", jsonData.id.toString());"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Dashboard Test Project\",\n  \"description\": \"Project for testing dashboard stats and my-tasks endpoints\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/projects",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"projects"
							]
						}
					}
				},
				{
					"name": "Create Task for Dashboard",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 - Task Created\", () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.environment.set(\"taskId\", jsonData.id.toString());"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Dashboard Test Task\",\n  \"description\": \"Task assigned for dashboard verification\",\n  \"priority\": \"Medium\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/projects/{{projectId}}/tasks",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"projects",
								"{{projectId}}",
								"tasks"
							]
						}
					}
				}
			]
		},
		{
			"name": "Dashboard API",
			"item": [
				{
					"name": "Get My Dashboard Stats",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 - OK\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"pm.test(\"Dashboard stats object contains required fields\", () => {",
									"    pm.expect(jsonData).to.have.property(\"tasksByStatus\");",
									"    pm.expect(jsonData).to.have.property(\"upcomingDeadlines\");",
									"    pm.expect(jsonData).to.have.property(\"totalAssigned\");",
									"    pm.expect(jsonData).to.have.property(\"overdueCount\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/dashboard/my-stats",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"dashboard",
								"my-stats"
							]
						}
					}
				},
				{
					"name": "Get My Tasks",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 - OK\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"pm.test(\"Paginated tasks object contains required pagination fields\", () => {",
									"    pm.expect(jsonData).to.have.property(\"items\");",
									"    pm.expect(jsonData.items).to.be.an(\"array\");",
									"    pm.expect(jsonData).to.have.property(\"page\");",
									"    pm.expect(jsonData).to.have.property(\"pageSize\");",
									"    pm.expect(jsonData).to.have.property(\"totalCount\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/dashboard/my-tasks?page=1&pageSize=20",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"dashboard",
								"my-tasks"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "pageSize",
									"value": "20"
								}
							]
						}
					}
				},
				{
					"name": "Get My Urgent Tasks Only",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 - OK\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"pm.test(\"Filtered urgent tasks response is valid paginated list\", () => {",
									"    pm.expect(jsonData).to.have.property(\"items\");",
									"    pm.expect(jsonData.items).to.be.an(\"array\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/dashboard/my-tasks?isUrgentOnly=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"dashboard",
								"my-tasks"
							],
							"query": [
								{
									"key": "isUrgentOnly",
									"value": "true"
								}
							]
						}
					}
				}
			]
		},
