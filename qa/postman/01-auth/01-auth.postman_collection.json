  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 201 - User created\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has id\", () => {\r",
              "    pm.expect(jsonData).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response has email\", () => {\r",
              "    pm.expect(jsonData).to.have.property(\"email\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response does NOT contain password\", () => {\r",
              "    const body = pm.response.text();\r",
              "    pm.expect(body).to.not.include(\"password\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const email =\r",
              "    \"qa_\" +\r",
              "    Date.now() +\r",
              "    \"@example.com\";\r",
              "\r",
              "pm.collectionVariables.set(\"email\", email);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
