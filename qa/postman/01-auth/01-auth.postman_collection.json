    {
      "name": "Get Me",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 - Get user info\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has body (not empty)\", () => {\r",
              "    pm.expect(pm.response.text()).to.not.be.empty;\r",
              "});\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"Has id, email, fullName\", () => {\r",
              "    pm.expect(body).to.have.property(\"id\");\r",
              "    pm.expect(body).to.have.property(\"email\");\r",
              "    pm.expect(body).to.have.property(\"fullName\");\r",
              "});\r",
              "\r",
              "pm.test(\"Does not expose passwordHash\", () => {\r",
              "    pm.expect(pm.response.text()).to.not.include(\"passwordHash\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Lấy token từ environment\r",
              "const token = pm.environment.get(\"token\");\r",
              "\r",
              "console.log(\"🔍 Token in pre-req:\", token ? \"✅ \" + token.substring(0, 20) : \"❌ MISSING\");\r",
              "\r",
              "if (token) {\r",
              "    // Xóa header cũ nếu có\r",
              "    pm.request.headers.remove(\"Authorization\");\r",
              "    // Thêm header mới\r",
              "    pm.request.headers.add({\r",
              "        key: \"Authorization\",\r",
              "        value: `Bearer ${token}`\r",
              "    });\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
