    {
      "name": "Login & Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();\r",
              "\r",
              "const payload = JSON.parse(\r",
              "    atob(jsonData.token.split(\".\")[1])\r",
              ");\r",
              "\r",
              "// 1. Kiểm tra status\r",
              "pm.test(\"Status code is 200 - Login successful\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Kiểm tra có token\r",
              "pm.test(\"Response has token\", () => {\r",
              "    pm.expect(jsonData).to.have.property(\"token\");\r",
              "    pm.expect(jsonData.token).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.token).to.not.be.empty;\r",
              "});\r",
              "\r",
              "// 3. Lưu token + refreshToken + userId vào environment (side-effect, KHÔNG dùng pm.test)\r",
              "pm.environment.set(\"token\", jsonData.token);\r",
              "if (jsonData.refreshToken) {\r",
              "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);\r",
              "}\r",
              "pm.environment.set(\"userId\", jsonData.user.id);\r",
              "console.log(\"✅ Token saved:\", jsonData.token.substring(0, 20) + \"...\");\r",
              "console.log(\"✅ Refresh Token saved:\", jsonData.refreshToken ? jsonData.refreshToken.substring(0, 10) + \"...\" : \"none\");\r",
              "console.log(\"✅ User ID saved:\", jsonData.user.id);\r",
              "\r",
              "// 4. Kiểm tra có user object\r",
              "pm.test(\"Response has user object\", () => {\r",
              "    pm.expect(jsonData).to.have.property(\"user\");\r",
              "});\r",
              "\r",
              "pm.test(\"JWT contains exp claim\", () => {\r",
              "    pm.expect(payload.exp).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"JWT expiration is in future\", () => {\r",
              "    const now = Math.floor(Date.now() / 1000);\r",
              "    pm.expect(payload.exp).to.be.above(now);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"Test@1234\"\r\n}",
          "options": {
