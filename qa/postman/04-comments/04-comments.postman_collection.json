		{
			"name": "Comments API - Happy Path",
			"item": [
				{
					"name": "Get Task Comments (empty)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 - OK\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is an empty array\", () => {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\");",
									"    pm.expect(jsonData).to.have.length(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/tasks/{{taskId}}/comments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tasks",
								"{{taskId}}",
								"comments"
							]
						}
					}
				},
				{
					"name": "Create Comment",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 - Created\", () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"",
									"pm.test(\"Comment has required fields\", () => {",
									"    pm.expect(jsonData).to.have.property(\"id\");",
									"    pm.expect(jsonData).to.have.property(\"content\");",
									"    pm.expect(jsonData).to.have.property(\"authorName\");",
									"    pm.expect(jsonData).to.have.property(\"createdAt\");",
									"});",
									"",
									"pm.test(\"Content matches input\", () => {",
									"    pm.expect(jsonData.content).to.eql(\"This is a test comment\");",
									"});",
									"",
									"pm.environment.set(\"commentId\", jsonData.id.toString());"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"This is a test comment\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/tasks/{{taskId}}/comments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tasks",
								"{{taskId}}",
								"comments"
							]
						}
					}
				},
				{
					"name": "Get Task Comments (has data)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 - OK\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is a non-empty array\", () => {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\");",
									"    pm.expect(jsonData.length).to.be.above(0);",
									"});",
									"",
									"pm.test(\"Comment has all required fields\", () => {",
									"    const comment = pm.response.json()[0];",
									"    pm.expect(comment).to.have.property(\"id\");",
									"    pm.expect(comment).to.have.property(\"content\");",
									"    pm.expect(comment).to.have.property(\"authorName\");",
									"    pm.expect(comment).to.have.property(\"createdAt\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/tasks/{{taskId}}/comments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tasks",
								"{{taskId}}",
								"comments"
							]
						}
					}
				},
